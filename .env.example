# Greenroom — copy to .env for local development. NEVER commit .env.
# No credential values belong in this file, in .env, or anywhere in the repo.
# The Gmail/Calendar OAuth refresh token lives ONLY in Secret Manager.

# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=europe-west2
# Routes the Gen AI SDK / ADK at Vertex AI (ADC) instead of an API key.
GOOGLE_GENAI_USE_VERTEXAI=true

# --- Agent mailbox ---
# MUST be a Google account. The Gmail API cannot serve a mailbox hosted elsewhere
# (beatidapp.com is on Zoho, which is why Greenroom runs from a dedicated Google
# account whose inbox contains nothing but its own threads).
GREENROOM_MAILBOX=

# --- Safety switches ---
# true = every send is logged and never performed. Default true for local dev.
GREENROOM_DRY_RUN=true

# --- Dashboard demo gate ---
# Single shared secret stored in a cookie. This is a hackathon demo gate, not auth.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
GREENROOM_DASHBOARD_SECRET=

# --- Inbound push verification ---
# Service account Pub/Sub uses to mint the OIDC token on push requests.
GREENROOM_PUSH_SA_EMAIL=
# Expected audience claim on that token (the Cloud Run service URL).
GREENROOM_PUSH_AUDIENCE=
